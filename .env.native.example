# =============================================================================
# .env para el despliegue NATIVO de Windows — copiar a `.env` y rellenar:
#     Copy-Item .env.native.example .env
#
# deploy.ps1 copia este .env a Backend\bootwhatsapp\.env (de donde Django lo lee).
# El engine (Node) recibe WHATSAPP_ENGINE_SECRET inyectado por el servicio NSSM.
#
# Solo están las variables que el código realmente usa. Las marcadas (OBLIGATORIA)
# bloquean el arranque del backend si faltan.
# =============================================================================

# ── DJANGO ───────────────────────────────────────────────────────────────────
# (OBLIGATORIA) genera con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Con un dominio real, añádelo aquí (p.ej. https://tudominio.com):
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:8000

# ── HTTPS / seguridad de cookies ─────────────────────────────────────────────
# El despliegue nativo (serve.py) sirve HTTP PLANO, sin TLS. Déjalo en False:
# activar la redirección a HTTPS sin un TLS real por delante causa un BUCLE de
# redirección infinito y deja el sitio inaccesible.
#
# Ponlo en True SOLO si tienes un terminador TLS real por delante (nginx/Caddy/
# túnel) y arrancas serve.py con --forwarded-proto https. Al activarlo se
# encienden: redirección HTTP→HTTPS, cookies Secure y HSTS.
ENABLE_HTTPS=False

# ── BASE DE DATOS (Postgres EXTERNO, ya instalado como servicio Windows) ──────
# NATIVO: Postgres corre en la misma máquina -> DB_HOST=localhost (NO host.docker.internal).
DB_NAME=bootwhatsapp
DB_USER=bootwhatsapp_user
DB_PASSWORD=            # (OBLIGATORIA) password del rol bootwhatsapp_user
DB_HOST=localhost
DB_PORT=5432

# ── WHATSAPP / META CLOUD API ────────────────────────────────────────────────
# Meta Developers -> tu App -> WhatsApp -> API Setup (token y phone_number_id),
# y Configuración básica (app secret). META_VERIFY_TOKEN es un valor libre que
# defines y repites en Meta -> Webhooks.
WHATSAPP_API_TOKEN=          # (OBLIGATORIA)
WHATSAPP_PHONE_NUMBER_ID=    # (OBLIGATORIA)
WHATSAPP_APP_SECRET=         # (OBLIGATORIA) valida la firma del webhook
META_VERIFY_TOKEN=           # (OBLIGATORIA) verificación del webhook

# ── IA ───────────────────────────────────────────────────────────────────────
# (OBLIGATORIA) Groq es el proveedor principal de texto -> https://console.groq.com/keys
GROQ_API_KEY=
# Together.ai: respaldo de texto + visión de imágenes (facturas DIAN, validación
# de documentos). Sin esta, el texto sigue por Groq pero NO se procesan imágenes.
TOGETHER_API_KEY=

# ── CIFRADO ──────────────────────────────────────────────────────────────────
# Cifra el access_token de cada conexión guardada en la BD.
# Genera: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OJO: no la cambies si ya hay conexiones guardadas — quedarían ilegibles.
FERNET_KEY=

# ── ENGINE (Node) ────────────────────────────────────────────────────────────
# (OBLIGATORIA) secreto compartido backend<->engine. Cualquier string largo.
# Genera: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NO uses un placeholder tipo "dev-...-change-in-prod": genera uno aleatorio.
WHATSAPP_ENGINE_SECRET=
# (RECOMENDADA en prod) IP(s) del host del engine con permiso para llegar al
# endpoint interno del backend. Vacío = solo protege el secret. Nativo mismo
# host: 127.0.0.1  ->  WHATSAPP_ENGINE_ALLOWED_IPS=127.0.0.1
WHATSAPP_ENGINE_ALLOWED_IPS=127.0.0.1

# ── JWT (RECOMENDADA) ─────────────────────────────────────────────────────────
# Clave dedicada para firmar los JWT, separada de SECRET_KEY. Si se omite, se
# firma con SECRET_KEY (una fuga de SECRET_KEY permitiria forjar tokens).
# Genera: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=

# ── PUBLICO / TUNEL (OPCIONAL) ────────────────────────────────────────────────
# URL publica del backend que ven los aliados. Con tunel/dominio real, ponla y
# añade el host EXACTO a ALLOWED_HOSTS y a CSRF_TRUSTED_ORIGINS (no comodines).
PUBLIC_API_BASE=

# ── REGISTRO PÚBLICO ─────────────────────────────────────────────────────────
# El endpoint /auth/register/ crea un usuario ADMIN + una empresa nueva sin
# invitación. CERRADO por defecto (devuelve 403): sin esto cualquiera en internet
# podría crear tenants a voluntad. Ponlo en True solo si quieres ofrecer signup
# público de auto-servicio.
ALLOW_PUBLIC_REGISTRATION=False

# ── OPCIONAL ─────────────────────────────────────────────────────────────────
# Solo si usas el gateway de Aliados (firma las integraciones). Si lo dejas
# vacío, el resto de la app funciona igual.
# Genera: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTEGRATION_SALT=
# Peticiones/minuto permitidas por cada API key de aliado (rate limit por key,
# ademas del limite anon por IP). Default 120 si se omite.
GATEWAY_KEY_RATE_PER_MIN=120
